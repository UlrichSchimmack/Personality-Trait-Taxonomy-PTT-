  C_ORDER     by MQ11_1 MQ11_2*-1 MQ11_6         ;           
  C_DETAIL    by MQ12_1 MQ12_3    MQ12_5         ;
  C_DETAIL    BY MQ47_6                          ;
  C_DEPEND    by MQ16_2 MQ16_3    MQ16_6         ;
  C_EFFICACY  by MQ15_2 MQ15_3    MQ15_4         ;
  C_EFFICACY  BY MQ75_3*                         ;
  C_ACHIEVE   by MQ47_4 MQ47_5    MQ47_6         ;
  C_PERSEVERE by MQ8_3  MQ8_4     MQ8_5          ;
  C_IMPULSIVE by MQ14_1 MQ14_3    MQ14_4         ;       
  C_PROCRAST  by MQ13_1 MQ13_2    MQ13_3         ;      
  C_PROCRAST  BY MQ9_2                           ;
