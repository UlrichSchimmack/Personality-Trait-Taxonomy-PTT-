  A  by A_PROVOKE*-1     ;
  A  BY A_ASSERT*-1      ; 
  A  BY A_LEADER*-1      ; 
  A  by A_INDIFF*-1      ;

  A  by N_ENVY*-.2       ;
  A  by N_INDECISIVE     ;
  A  by N_COURAGE        ;
  A  by N_CAUTIOUS       ;
  A  by N_DISTRUST       ;
  A  by N_IRRIT*-.2      ;

  A  by E_ATTENTION*-.2  ; 
  A  by E_EXCITE*-.2     ;
  A  by E_CONF*-.2       ;
  A  by E_S_CONF*.2      ;
  A  by E_VIGOR*-2       ;
  
  A  BY O_CREATIVE*-.2   ;
  A  BY O_ECCENTRIC*-.2  ;
  A  by O_PUNITIVE       ;

  A  by C_ACHIEVE        ;
  A  by C_IMPULSIVE*-.5  ;
  
  !!!


! ========================================================================
! 5E | BROAD CONSCIENTIOUSNESS
! ========================================================================
  C  by C_S_CONTROL      ;
  C  by C_PLAN           ;  
  C  by C_ORDER          ;
  C  by C_DETAIL         ;
  C  by C_EFFICACY       ;
  C  by C_DEPEND         ;
  C  by C_PERSEVERE      ;
  C  by C_IMPULSIVE*-1   ;
  C  by C_PROCRAST*-1    ;
  C  bY C_DISTRACT*-1    ;
  C  by C_ACHIEVE        ;

  C  by N_INDECISIVE*-.2 ;
  C  by N_TOL_AMBI*.2    ;
  C  by N_CAUTIOUS       ;

  C  by E_EXCITE*-.2     ;
  C  BY E_WARMTH*.2      ;
  C  BY E_POS            ; 
  C  BY E_ATTENTION*-.2  ; 
  
  C  by O_FANTA*-.2      ;
  C  by O_ECCENTRIC*-.2  ;
  C  by O_TRAD           ;
  C  BY O_NOVEL*-.2      ;
  C  BY O_PUNITIVE       ;

  C  by A_IMMORAL*-.2    ;
  
  !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!


! ========================================================================
! 6 | CORRELATED FACET RESIDUALS
! WITH specifies covariance between facet residual components when they
! are indicators of the broader factors; some relations are cross-domain.
! These may reflect narrow common processes, semantic overlap, or local
! dependence. They are not automatically additional global factors.
! Lines beginning with ! are deliberately inactive/commented out.
! ========================================================================
  N_RUMINATE WITH N_WORRY *.2;

  N_S_STRESS with N_WORRY*.2;
  N_S_STRESS with N_IRRIT*.2;
  N_WORRY    with N_IRRIT;
  
  N_CAUTIOUS with N_COURAGE*-.2;

  N_DEP      with E_POS;
  N_DEP      with E_SURGE*-.2;
  N_DEP      with E_GRATITUDE*-.2;

  N_S_CRITIC with E_ACCEPT;
  N_S_CRITIC with E_CONF;

  N_RUMINATE with E_SOCDEP*-.2;
  N_COURAGE  with E_EXCITE;
  N_CAUTIOUS with E_EXCITE;
  N_COURAGE  with E_VIGOR;
  
  N_TOL_AMBI with O_N_COG;
  N_EXTRO    with O_INTROSPEC;
  
  N_DEP      with A_SUPERIOR*-.2      ;
  N_EXTRO    with A_HELPFUL;
  N_TOL_AMBI with A_STUBBORN;
  N_IRRIT    with A_STUBBORN;
 

  !!!
  

! ========================================================================
! 6B | RESIDUAL ASSOCIATIONS: E AND CROSS-DOMAIN
! ========================================================================
  E_AFFA     with E_CONF;
  E_AFFA     with E_S_CONF;
  E_CONF     with E_S_CONF;
  E_SOC      with E_S_RELY;
  E_CONF     with E_DISCLOSE;
  E_VIGOR    WITH E_SURGE  ; 
  E_WARMTH   with E_AFFA;

  E_POS      WITH E_SURGE;
  E_POS      with E_GRATITUDE;
  E_SURGE    with E_GRATITUDE;

  E_SURGE    with O_HUMOR*-.2;
  E_DISCLOSE with O_TRAD;

  E_WARMTH   with O_N_COG*-.2;
  E_AFFA     with O_ABSTRACT*-.2;
  E_EBDM     with O_FANTA;
  E_EXCITE   with O_NOVEL;

  E_WARMTH   with A_HELPFUL;
  E_EBDM     with A_SUPERIOR;
  E_ACCEPT   with A_ASSERT;
  
  E_VIGOR    with C_S_CONTROL*-.2;
  E_EBDM     with C_IMPULSIVE;


  !!!


! ========================================================================
! 6C | RESIDUAL ASSOCIATIONS: O AND CROSS-DOMAIN
! ========================================================================
  O_ABSTRACT  with O_N_COG;
  O_FANTA     WITH O_ABSORB;
  O_INTROSPEC WITH O_CREATIVE*-.2;
  O_TRAD      WITH O_PUNITIVE;

  O_N_COG     WITH E_EBDM*-.2   ; 
  O_HUMOR     WITH E_VIGOR*-.2  ; 

  O_ART       with C_EFFICACY*-.2;
  

  !!!


! ========================================================================
! 6D | RESIDUAL ASSOCIATIONS: A / ANTAGONISM
! ========================================================================
  A_MANI with A_VENGEFUL;
  A_MANI with A_SUPERIOR;
  A_MANI with A_CONFRONT;
  A_MANI with A_PROVOKE;

  A_VENGEFUL with A_SUPERIOR;
  A_VENGEFUL with A_CONFRONT;
  A_VENGEFUL with A_PROVOKE;

!  A_SUPERIOR with A_CONFRONT;
!  A_SUPERIOR with A_PROVOKE;

  A_VENGEFUL with A_STUBBORN;
  A_ASSERT   with A_STUBBORN;
  A_CRITICAL with A_STUBBORN;
  A_FORGIVE  with A_STUBBORN;

  A_CONFRONT with A_PROVOKE;

  A_PROVOKE   with A_CONFRONT;
  A_SYMPATHY  WITH A_HELPFUL;

  A_LEADER   WITH A_VENGEFUL*-.2;
  A_FORGIVE  WITH A_VENGEFUL*-.2;

  A_MANI     with A_IMMORAL;
  A_VENGEFUL with A_IMMORAL;
  A_SUPERIOR with A_IMMORAL;
  A_CONFRONT with A_IMMORAL;
  A_PROVOKE  with A_IMMORAL;

  A_IMMORAL with C_S_CONTROL; 

  A_HONEST  with A_IMMORAL*-.2;
  A_HONEST  with A_MANI*-.2;
 
  !!!


! ========================================================================
! 6E | RESIDUAL ASSOCIATIONS: C
! ========================================================================
  C_PROCRAST  with C_DISTRACT;


