! ========================================================================
! 5 | SECOND-ORDER BIG FIVE FACTORS
! N, E, O, A, C are broad latent factors defined by facet factors.
! Each begins with primary facet loadings; secondary loadings on facets
! from other domains are estimated in the later statements.
! Thus independent broad factors can still explain cross-domain overlap.
! Check estimated factor correlations/identification before inferring
! that higher-order orthogonality was formally imposed in every variant.
! ========================================================================
  N by N_S_STRESS;
  N by N_Worry;
  N by N_DEP;
  N by N_RUMINATE;
  N by N_S_CRITIC;
  N by N_IRRIT;
  N by N_ENVY;
  N by N_INDECISIVE;
  N by N_TOL_AMBI;
  N by N_INSECURE;
  N by N_EXTRO;
  N by N_COURAGE;
  N by N_CAUTIOUS;
  N by N_DISTRUST;

  N by E_CONF*-.5;
  N by E_SURGE*-.2;
  N by E_AFFA*-.2;
  N by E_S_CONF*-2;
  N by E_S_RELY*;
  N by E_POS*-.2;
  N by E_VIGOR*-.5;
  N by E_DISCLOSE*-.2;
  N by E_ATTENTION*-.2;
  N by E_ACCEPT;
  N BY E_SOC*-.2;
  N by E_WARMTH*-.2;
  N by E_EXCITE*-.2;

  N BY O_FANTA*.2;
  N by O_CREATIVE*-.2;
  N BY O_ABSTRACT; 
  N BY O_HUMOR*-.2; 
  
  N BY A_FAIR ; 
  N by A_SUPERIOR*-.2;
  N by A_CONFRONT;
  N BY A_CRITICAL;
  N BY A_FORGIVE*-.2;
  N by A_INDIFF*1;
  N BY A_ASSERT*-.2; 
  N BY A_SYMPATHY ; 
  N BY A_MANI*-.2;
  N BY A_PROVOKE*-.2;
  N BY A_LEADER*-.2;
  N by A_STUBBORN;

  N BY C_DISTRACT*.2;
  N BY C_PROCRAST*.2;
  N BY C_S_CONTROL*-.2;
  N BY C_EFFICACY*-.2;
  N BY C_PERSEVERE*-.2;
  N by C_ACHIEVE;
  N BY C_DEPEND*-.2; 
  
  !!!


! ========================================================================
! 5B | BROAD EXTRAVERSION
! ========================================================================
  E by E_WARMTH;
  E by E_SOC;
  E by E_CONF;
  E by E_S_CONF;
  E by E_AFFA;
  E by E_SURGE;
  E by E_VIGOR;
  E by E_SOCDEP;
  E by E_S_RELY;
  E by E_POS;
  E by E_GRATITUDE;
  E by E_DISCLOSE;
  E by E_ATTENTION;
  E by E_EBDM;
  E by E_ACCEPT;
  E by E_EXCITE;
  E by N_DISTRUST;

  E BY N_IRRIT*-.2;
  E by N_DEP*-.2;
  E by N_INSECURE;
  E by N_EXTRO;
  E by N_CAUTIOUS;

  E by O_CURIOUS*-2;
  E BY O_NOVEL*.2;
  E by O_ECCENTRIC;
  E by O_HUMOR;
  E by O_ABSORB;
  E BY O_INTROSPEC *.5;
  E by O_TRAD;

  E by A_LEADER;
  E by A_FORGIVE;
  E by A_HELPFUL;
  E by A_SYMPATHY;
  E BY A_INDIFF*-.2;
  E BY A_SUPERIOR*.2;
  E BY A_STUBBORN*-.2; 
  
  E by C_IMPULSIVE;
  E by C_ACHIEVE;

  !!!



! ========================================================================
! 5C | BROAD OPENNESS
! ========================================================================
  O by O_CURIOUS;
  O by O_ART;
  O by O_ABSTRACT;
  O by O_NOVEL;
  O by O_ABSORB;
  O by O_FANTA;
  O by O_CREATIVE;
  O by O_N_COG;
  O by O_ECCENTRIC;
  O by O_HUMOR;
  O by O_INTROSPEC;
  O by O_PUNITIVE;
  O by O_TRAD;  

  O by N_TOL_AMBI*.2;
  O by N_EXTRO;
  O by N_CAUTIOUS;
  O by N_COURAGE;

  O by E_EXCITE;

  O by A_SYMPATHY;
  O BY A_INDIFF*-.2   ; 

  O BY C_EFFICACY*.2;

  !!!


! ========================================================================
! 5D | BROAD AGREEABLENESS
! ========================================================================
  A  by A_FORGIVE        ;
  A  by A_HELPFUL        ;
  A  by A_SYMPATHY       ;
  A  by A_HONEST         ;
  A  by A_FAIR           ; 

  A  by A_STUBBORN*-1    ;
